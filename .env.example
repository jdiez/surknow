# SurrealDB
DKG_SURREAL_URL=ws://localhost:8000/rpc
DKG_SURREAL_NAMESPACE=domain_kg
DKG_SURREAL_DATABASE=default
DKG_SURREAL_USER=root
DKG_SURREAL_PASS=root

# AWS Bedrock (via AI Gateway)
DKG_AI_GATEWAY_KEY=
DKG_AI_GATEWAY_URL=
DKG_AWS_REGION=us-east-1
DKG_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Agno Storage
DKG_AGNO_STORAGE_URL=postgresql://localhost:5432/domain_kg

# Search
DKG_SEARCH_PROVIDER=tavily
DKG_SEARCH_API_KEY=

# Pipeline
DKG_MAX_ITERATIONS=3
DKG_COVERAGE_THRESHOLD=0.8
DKG_CONFIDENCE_THRESHOLD=0.7
DKG_MAX_ENTITIES_PER_BRANCH=50
DKG_PARALLEL_BRANCHES=5
